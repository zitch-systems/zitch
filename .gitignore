node_modules/
.venv/
.expo/
dist/
npm-debug.*

# Native projects are generated by `expo prebuild --clean` and are never a source
# of truth — native config lives in app.json and plugins/. Also keeps CI's
# android/gradle.properties (which holds the upload-keystore passwords during an
# android-aab build) from ever being committable.
/android/
/ios/

# Django user-uploaded media (avatars) — runtime artifacts, not source.
backend/media/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Local env files — never commit real secrets (.env.example is the template)
.env
.env.*
!.env.example

# macOS
.DS_Store

