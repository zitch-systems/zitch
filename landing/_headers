/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fingerprinted, rarely-changing static assets — cache hard for fast repeat views.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand mark + base design-system tokens/fonts for the landing — also long-lived.
/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/_ds/*
  Cache-Control: public, max-age=31536000, immutable
