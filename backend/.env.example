# Copy to .env for local development (never commit the real .env).

# Core
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006

# Database — leave unset to use local SQLite. On Render this is injected.
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME

# Session lifetime for issued access tokens, in hours.
TOKEN_TTL_HOURS=24
# Admin/operator (staff-scoped) tokens expire much sooner — a leaked back-office
# token is high blast-radius, so keep this short.
ADMIN_TOKEN_TTL_HOURS=2

# Manual wallet-credit guardrails (back-office goodwill/refund credits): a single
# credit can't exceed the first cap, and one operator can't exceed the daily cap
# in a rolling 24h — bounds insider/compromised-operator risk.
ADMIN_MAX_MANUAL_CREDIT=500000
ADMIN_MANUAL_CREDIT_DAILY_CAP=2000000

# Per-account operator-login lockout (on top of the per-IP limit): after N failed
# attempts against one identifier, further attempts are refused for the window.
ADMIN_LOGIN_MAX_FAILS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# Per-IP rate limiting on auth endpoints. On by default; for accurate limits
# across gunicorn workers, back the Django cache with Redis (or rate-limit at
# the edge). Set to false to disable.
RATELIMIT_ENABLE=true

# --- Production security (all auto-ON when DJANGO_DEBUG=false) ---
# Behind Render's TLS proxy, a real deploy automatically enforces the HTTPS
# redirect, secure session/CSRF cookies, and 1-year HSTS — no setup needed.
# Override a single flag only for an unusual setup (e.g. a non-TLS network):
# DJANGO_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=false   # opt-in: only once the domain is committed HTTPS-only

# --- Third-party services (leave blank in dev: the app runs in MOCK mode) ---
# VTU / bills — VTU.ng (v2): airtime, data, cable, electricity, betting. JWT
# Bearer auth, no IP whitelisting. Set a long-lived token (VTUNG_API_KEY) OR
# username+password (a JWT is fetched & refreshed automatically). Blank => MOCK.
VTUNG_BASE_URL=https://vtu.ng
VTUNG_API_KEY=
VTUNG_USERNAME=
VTUNG_PASSWORD=

# Money-movement rail — Wema / ALAT (Banking-as-a-Service): the SOLE rail for funding
# (dedicated NUBANs via a BVN/NIN + OTP flow), payouts + recipient name enquiry +
# balance, Nigeria KYC (BVN/NIN/vNIN via Full KYC), VAS (airtime/data/bills) and a
# Virtual Naira Card. Azure APIM auth: a per-PRODUCT subscription key
# (Ocp-Apim-Subscription-Key) + a channel id (x-api-key / access). Sandbox host
# https://apiplayground.alat.ng (LIVE differs — set WEMA_BASE_URL). Blank keys => mock;
# WEMA_SIMULATION=true serves the mock flow even in prod (no real money).
# There is no inbound-credit webhook for DEPOSITS — those are still polled by
# reconcile_wema. The bank does call us for account creation, payout authorisation and
# transaction status: see the callback block below (WEMA_CALLBACK_*).
# securityInfo: ALAT's integration guide shows it arriving on the AUTHENTICATION
# callback (the bank asks us to authorise a payout), not only as a request field.
# Wema/ALAT egress IPs (the addresses their gateway calls FROM), supplied 2026-07-27:
#   135.236.18.76, 74.178.162.156 — enforced by WEMA_CALLBACK_ENFORCE_IPS below.
WEMA_BASE_URL=https://apiplayground.alat.ng
WEMA_CHANNEL_ID=
WEMA_WALLET_KEY=
# Card-Management subscription key (enables the NUBAN-keyed virtual-card backend).
WEMA_CARD_KEY=
# The cardKey (card product id) ALAT's virtualCard request needs — distinct from the
# subscription key above; supplied by Wema. Blank until then.
WEMA_CARD_PRODUCT_KEY=
# Airtime/data, bills and Remita are all bundled INTO the ALAT Wallet Services
# subscription (its portal listing covers 13 APIs), so leave these blank and the wallet
# key authenticates them. Only set one if Wema ever issues a dedicated subscription —
# a value here always wins over the wallet key.
WEMA_AIRTIME_KEY=
WEMA_BILLS_KEY=
# Remita RRR bill payment (enables /api/utility/validate_rrr + payremita).
WEMA_REMITA_KEY=
# Buy-Now-Pay-Later: APIM subscription key + merchant credentials (BNPL uses a different
# auth scheme — x-merchant-id + x-merchant-authorization-key — alongside the sub key).
# Only the read-only offers endpoint is exposed; the credit-commitment flow is gated.
WEMA_BNPL_KEY=
WEMA_BNPL_MERCHANT_ID=
WEMA_BNPL_AUTH_KEY=
# Reserved: BVN/NIN identity is verified through the wallet-creation (provisioning) flow;
# ALAT has no standalone KYC-lookup product. The Partnership Account KYC API is bundled
# into Wallet Services, so this falls back to the wallet key and normally stays blank.
WEMA_KYC_KEY=
# Our own Wema pool/settlement NUBAN that funds outbound transfers (required for payouts).
WEMA_SOURCE_ACCOUNT=
# A value WE choose (Wema confirmed 2026-07-27: "a private key best known to you") that the
# bank echoes back to our Authentication Callback with each payout authorisation request.
# Not issued by the bank, and not required for payouts to settle — the callback authorises
# from our own ledger. Set any long random value to enable WEMA_AUTH_REQUIRE_SECURITY_INFO.
WEMA_SECURITY_INFO=
WEMA_SIMULATION=false
# --- Bank-called callbacks (wallet/wema_callbacks.py) ---------------------------
# ALAT PROFILES these URLs and the rails do not work until it has: account creation
# is refused without a profiled Account Creation URL, and transactions fail
# authentication without the Authentication URL. Give Wema:
#   https://<host>/webhooks/wema/account/<WEMA_CALLBACK_TOKEN>
#   https://<host>/webhooks/wema/authorize/<WEMA_CALLBACK_TOKEN>
#   https://<host>/webhooks/wema/transaction/<WEMA_CALLBACK_TOKEN>
#   https://<host>/webhooks/wema/notification/<WEMA_CALLBACK_TOKEN>   (production)
# Verify all four before handing them over, using an Authorization bearer header:
#   GET /wema-callbacks-diagnose  -> ready_to_send_to_the_bank: true
# The response contains URL templates, never the callback token itself.
# The bank signs nothing, so the token in the path is the shared secret. Generate a
# long random value; _PREV keeps the old one valid during a rotation.
WEMA_CALLBACK_TOKEN=
WEMA_CALLBACK_TOKEN_PREV=
# Source-IP allowlist of the bank's gateway egress addresses. Blank defaults secure
# in production and off in debug/tests. Diagnose the trusted proxy hop before a dev
# profiling test; Azure egress addresses can change, so keep this env-overridable.
WEMA_CALLBACK_ENFORCE_IPS=
WEMA_CALLBACK_IPS=135.236.18.76,74.178.162.156
# Payout authorisation: only authorise a PENDING bank payout younger than this (secs).
WEMA_AUTH_MAX_AGE=900
# Require the callback's securityInfo to match WEMA_SECURITY_INFO. Blank defaults on
# in production and off in debug/tests. Zitch chooses this strong private value; a
# missing or mismatched value must deny a production payout.
WEMA_AUTH_REQUIRE_SECURITY_INFO=
# Set to any secret to enable the remote self-tests at /wema-diagnose,
# /vtu-diagnose, /sms-diagnose and /wema-callbacks-diagnose. Authenticate with
# `Authorization: Bearer <token>`; never put credentials or identity data in URLs.
# Blank disables them.
DIAG_TOKEN=
WEMA_DIAG_TOKEN=
# Virtual-card backend: "wema" or "issuer". Explicit value wins; blank => AUTO (Wema's
# Virtual Naira Card once WEMA_CARD_KEY is set, else the generic CARD_ISSUER below).
CARD_PROVIDER=

# Open banking — Mono (link external bank, view balance/transactions, fund the
# wallet via DirectPay). The Connect widget runs in the app with PUBLIC_KEY;
# server calls use SECRET_KEY (mono-sec-key header). Blank SECRET_KEY => mock
# mode. WEBHOOK_SECRET is compared to the mono-webhook-secret header. Set the
# Mono dashboard webhook to https://<host>/api/banklink/webhook/.
MONO_BASE_URL=https://api.withmono.com
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_WEBHOOK_SECRET=

# SMS / OTP — Termii is the only SMS rail. Blank TERMII_API_KEY => MOCK mode: send_sms
# returns a silent success and NOTHING is sent, so no OTP-by-SMS is delivered. The code
# is not logged or stored anywhere either (only its hash is), so there is nowhere to go
# looking for it — use the TEST_OTP pair below instead. A key alone is not enough
# either — see the sender-ID note below.
# NOTE the api_key travels in the request BODY, not an Authorization header.
# TERMII_BASE_URL: Termii serves several regional hosts; use the one your dashboard
# shows for YOUR account. A wrong host authenticates as nobody and delivers nothing.
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_API_KEY=
# Must be an APPROVED sender ID, and whitelisted for DND to reach most Nigerian
# numbers. Unapproved = accepted by the API, never delivered to the handset.
TERMII_SENDER_ID=Zitch
# "dnd" is the TRANSACTIONAL route and the correct one for OTP. "generic" is
# promotional-only and must not be used for codes.
TERMII_CHANNEL=dnd
# No webhook is required to SEND. Termii's webhook carries delivery reports (DLR) and
# inbound messages only; sending is synchronous and returns a message_id. Configure one
# in the Termii console only if you want handset-level delivery confirmation.

# Email / OTP fallback — Resend. Sends the same OTP code in parallel with
# Termii; blank API_KEY => mock mode (silent success). FROM_EMAIL must be on
# a verified Resend sending domain or Resend will reject.
RESEND_BASE_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL="Zitch <no-reply@send.zitch.ng>"

# KYC — BVN / NIN identity is verified by the Wema NUBAN account-creation flow (ALAT has
# no standalone lookup; the holder name it returns is name-matched before the tier lifts).
# Prembly below is retained ONLY for the image/biometric checks that flow can't do:
# selfie/liveness (the ≥₦100k transfer gate), address, and ID-document OCR.
# KYC — selfie/liveness + address + ID-document — Prembly (IdentityPass)
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=
PREMBLY_APP_ID=

# Card issuer — virtual cards (provider TBD)
CARD_ISSUER_BASE_URL=
CARD_ISSUER_API_KEY=
CARD_ISSUER_BRAND=Verve

# --- WhatsApp channel — Meta Cloud API (blank TOKEN => MOCK mode) ---
# Webhook: GET/POST https://<host>/webhooks/whatsapp  (set the same VERIFY_TOKEN
# in the Meta app dashboard). APP_SECRET enables inbound HMAC verification.
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_MODE=disabled              # disabled | sandbox (local/test only) | live
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_NUMBER=        # digits only (e.g. 234801...), for wa.me deep links
WHATSAPP_ALLOW_CHAT_SIGNUP=false # keep false in production; use app/secure Flow for PIN setup
# 32+ random bytes, identical on the API and WhatsApp worker. Encrypts queued
# inbound command text; rotate only after the queue is empty.
WHATSAPP_QUEUE_KEY=
# Optional rotation overlap. Set this to the old key, deploy the new current key
# everywhere, drain old jobs, then remove it.
WHATSAPP_QUEUE_KEY_PREV=

# WhatsApp Flows — the secure PIN pad. When set (and the channel is live), a money
# confirm sends an encrypted Flow whose masked PIN field never reaches the chat;
# its submit hits POST /webhooks/whatsapp/flow. Blank => the channel keeps using
# the single-use SMS confirmation code (verify-before-live). Requires Meta business
# verification first. Steps: (1) publish whatsapp/flow_assets/pin_flow.json in the
# Flow Builder → get the FLOW_ID; (2) generate an RSA-2048 keypair, set
# WHATSAPP_FLOW_PRIVATE_KEY to the private PEM and upload the PUBLIC key to the WABA
# (Business encryption endpoint); (3) point the Flow's endpoint URI at
# https://<host>/webhooks/whatsapp/flow.
WHATSAPP_FLOW_ID=
WHATSAPP_FLOW_PRIVATE_KEY=          # RSA private key PEM (use \n or a multiline secret)
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
WHATSAPP_FLOW_CTA=Confirm with PIN

# WhatsApp AI intent layer (blank API_KEY => AI off; the deterministic router
# handles everything). The model only proposes intents; it never moves money.
LLM_API_KEY=
LLM_MODEL=                       # optional, e.g. claude-haiku-4-5-20251001

# FX rail — Fincra (multi-currency conversion). Blank SECRET_KEY => MOCK mode
# (deterministic rates, auto-settle). NGN/USD/GBP/CAD settle; CNY is quote-only.
FINCRA_BASE_URL=https://api.fincra.com
FINCRA_SECRET_KEY=
FINCRA_BUSINESS_ID=
