{
  "version": "5.1",
  "data_api_version": "3.0",
  "routing_model": {
    "PIN_SCREEN": ["SUCCESS"]
  },
  "screens": [
    {
      "id": "PIN_SCREEN",
      "title": "Confirm payment",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Send ₦5,000 to JOHN DOE"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.summary}"
          },
          {
            "type": "TextBody",
            "text": "${data.error}"
          },
          {
            "type": "Form",
            "name": "pin_form",
            "children": [
              {
                "type": "TextInput",
                "name": "pin",
                "label": "Transaction PIN",
                "input-type": "password",
                "required": true,
                "helper-text": "Your 4–6 digit PIN — entered privately, never sent to the chat"
              },
              {
                "type": "Footer",
                "label": "Confirm",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "pin": "${form.pin}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Done",
      "terminal": true,
      "success": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "✅ Transfer successful"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
