{
  "version": "5.1",
  "data_api_version": "3.0",
  "routing_model": {
    "PIN_SCREEN": [
      "SUCCESS"
    ],
    "IDENTITY_SCREEN": [
      "EMAIL_SCREEN",
      "SUCCESS"
    ],
    "EMAIL_SCREEN": [
      "IDENTITY_SCREEN",
      "SUCCESS"
    ]
  },
  "screens": [
    {
      "id": "IDENTITY_SCREEN",
      "title": "Verify your identity",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "Enter your 11-digit BVN"
        },
        "label": {
          "type": "string",
          "__example__": "BVN"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.summary}"
          },
          {
            "type": "TextBody",
            "text": "${data.error}"
          },
          {
            "type": "Form",
            "name": "identity_form",
            "children": [
              {
                "type": "TextInput",
                "name": "number",
                "label": "${data.label}",
                "input-type": "password",
                "required": true,
                "helper-text": "Entered privately — this number never appears in your chat"
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "number": "${form.number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "EMAIL_SCREEN",
      "title": "Verify your email",
      "data": {
        "summary": {
          "type": "string",
          "__example__": "What's your email address?"
        },
        "label": {
          "type": "string",
          "__example__": "Email address"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.summary}"
          },
          {
            "type": "TextBody",
            "text": "${data.error}"
          },
          {
            "type": "Form",
            "name": "email_form",
            "children": [
              {
                "type": "TextInput",
                "name": "number",
                "label": "${data.label}",
                "input-type": "email",
                "required": true,
                "helper-text": "Entered privately — this never appears in your chat"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "number": "${form.number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PIN_SCREEN",
      "title": "Confirm payment",
      "data": {
        "amount": {
          "type": "string",
          "__example__": "₦5,000.00"
        },
        "recipient": {
          "type": "string",
          "__example__": "To JOHN DOE"
        },
        "details": {
          "type": "string",
          "__example__": "GTBank · 0123456789"
        },
        "error": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.amount}"
          },
          {
            "type": "TextBody",
            "text": "${data.recipient}"
          },
          {
            "type": "TextBody",
            "text": "${data.details}"
          },
          {
            "type": "TextBody",
            "text": "${data.error}"
          },
          {
            "type": "Form",
            "name": "pin_form",
            "children": [
              {
                "type": "TextInput",
                "name": "pin",
                "label": "Transaction PIN",
                "input-type": "password",
                "required": true,
                "helper-text": "Your 4–6 digit PIN — entered privately, never sent to the chat"
              },
              {
                "type": "Footer",
                "label": "Confirm",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "pin": "${form.pin}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Done",
      "terminal": true,
      "success": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "✅ Transfer successful"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
