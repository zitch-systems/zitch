{
  "expo": {
    "name": "Zitch",
    "slug": "zitch",
    "description": "Zitch is a Nigerian money app for instant bank transfers, airtime, data and bill payments — plus banking on WhatsApp.",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zitch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zitch.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "buildNumber": "12"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#03304C"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.zitch.app",
      "allowBackup": false,
      "versionCode": 12,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Zitch to use Face ID to sign you in and approve payments."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Zitch to use the camera to verify your identity (face check)."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zitch to use the camera to scan QR codes for payments.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Zitch to save your transaction receipts to your photos.",
          "photosPermission": "Allow Zitch to save your transaction receipts to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#03304C"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a2e8a1ed-506f-4fc8-9783-210c8aab1060"
      }
    },
    "owner": "zitch"
  }
}
