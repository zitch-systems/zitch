# Copy to .env for local development. Never commit the real file — .gitignore
# already excludes .env and .env.* (except this .example).

# --- Meta / WhatsApp Cloud API ---------------------------------------------
# A permanent or long-lived System User access token with, at minimum,
# whatsapp_business_management read access. This connector never writes,
# deletes, or rotates anything at Meta, so it never needs more than read scope.
META_ACCESS_TOKEN=

# WhatsApp Business Account ID (Meta Business Manager -> WhatsApp Accounts).
META_WABA_ID=

# The phone number ID Zitch sends from (WhatsApp Manager -> Phone numbers).
META_PHONE_NUMBER_ID=

# Optional. Not required by any tool today; reserved for a future
# credential-introspection tool that would need an app access token.
# META_APP_ID=
# META_APP_SECRET=

# Optional overrides.
# META_GRAPH_API_VERSION=v21.0
# META_GRAPH_API_BASE_URL=https://graph.facebook.com

# --- Connector auth -----------------------------------------------------
# Required on every request, as a Bearer token or X-Connector-Api-Key header.
# Still fully supported alongside OAuth: it is what curl checks, health
# probes and a future GPT Action use, since none of those can run a browser
# redirect flow. Generate with: openssl rand -hex 32
CONNECTOR_API_KEY=

# --- Meta CONFIG WRITES (off by default) -----------------------------------
# Leave unset and the connector is strictly read-only: the write tools are not
# registered at all — absent from tools/list, from the REST mirror, and from
# MCP dispatch, rather than present and refusing.
#
# Set true ONLY deliberately. This connector shares a WhatsApp Business
# Account with the live customer banking channel, and the token needs Meta
# write scope for these to work (see README).
#
# What writes CAN do: create/edit/delete message templates, update the public
# business profile, and create/upload/publish/deprecate Flows.
# What they can NEVER do, in any mode: send a WhatsApp message, change a
# webhook subscription, register a phone number, rotate a token, or move money.
# META_ALLOW_WRITES=false
#
# Every write tool requires a `confirm` argument restating the exact resource
# it will change. Turning this off removes that interlock — it is what stops a
# misread instruction deprecating the wrong Flow. Leave it on.
# META_REQUIRE_WRITE_CONFIRMATION=true

# --- OAuth 2.1 (for Claude web custom connectors) --------------------------
# Claude's connector UI can only sign in through a browser OAuth flow, so the
# server exposes one. Everything below is OPTIONAL — with none of it set,
# OAuth already works: clients register dynamically (RFC 7591), the consent
# screen accepts CONNECTOR_API_KEY as the operator passphrase, and tokens are
# signed with a key derived from it.
#
# The public origin, e.g. https://zitch-meta-connector.onrender.com. Leave
# unset behind Render (it is derived from X-Forwarded-Proto/Host); set it if
# this ever sits behind a proxy that does not send those headers.
# PUBLIC_BASE_URL=
#
# What the operator types on the consent screen. Defaults to
# CONNECTOR_API_KEY. Set this to decouple "who may approve a sign-in" from
# "what a script uses as its API key". Generate with: openssl rand -hex 32
# OAUTH_LOGIN_PASSWORD=
#
# Signs client_ids and access/refresh tokens. Defaults to a value derived
# from CONNECTOR_API_KEY. Rotating either one invalidates every outstanding
# OAuth token immediately — that is the revocation mechanism, since tokens
# are stateless and there is no per-token denylist.
# OAUTH_SIGNING_KEY=
#
# Hosts a redirect_uri may point at. Dynamic client registration is
# unauthenticated by design (that is what lets Claude register itself), so
# this allowlist is what stops the service being used as an open redirector.
# Defaults to: claude.ai,claude.com,localhost,127.0.0.1
# OAUTH_ALLOWED_REDIRECT_HOSTS=
#
# Optional pre-shared client, for a client that cannot do dynamic
# registration. Set BOTH or NEITHER — half-configured fails at boot.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# Redirect URIs for that static client. Defaults to Claude's two callbacks.
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# --- Server ---------------------------------------------------------------
# PORT=8787
# GRAPH_TIMEOUT_MS=10000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=30
# Coarser pre-auth budget, keyed by IP alone, so a flood of wrong/missing-key
# requests is throttled too (not just authenticated traffic). Must be >=
# RATE_LIMIT_MAX_REQUESTS.
# IP_RATE_LIMIT_MAX_REQUESTS=60
