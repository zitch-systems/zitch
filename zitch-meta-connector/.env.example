# Copy to .env for local development. Never commit the real file — .gitignore
# already excludes .env and .env.* (except this .example).

# --- Meta / WhatsApp Cloud API ---------------------------------------------
# A permanent or long-lived System User access token with, at minimum,
# whatsapp_business_management read access. This connector never writes,
# deletes, or rotates anything at Meta, so it never needs more than read scope.
META_ACCESS_TOKEN=

# WhatsApp Business Account ID (Meta Business Manager -> WhatsApp Accounts).
META_WABA_ID=

# The phone number ID Zitch sends from (WhatsApp Manager -> Phone numbers).
META_PHONE_NUMBER_ID=

# Optional. Not required by any tool today; reserved for a future
# credential-introspection tool that would need an app access token.
# META_APP_ID=
# META_APP_SECRET=

# Optional overrides.
# META_GRAPH_API_VERSION=v21.0
# META_GRAPH_API_BASE_URL=https://graph.facebook.com

# --- Connector auth -----------------------------------------------------
# Required on every request, as a Bearer token or X-Connector-Api-Key header.
# Generate with: openssl rand -hex 32
CONNECTOR_API_KEY=

# --- Server ---------------------------------------------------------------
# PORT=8787
# GRAPH_TIMEOUT_MS=10000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=30
